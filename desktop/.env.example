# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID -> "Desktop app".
# Use the same project as the phone app (Drive API enabled). See README.md.
VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Desktop clients get a secret that Google documents as non-confidential; the token endpoint still requires it.
VITE_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
